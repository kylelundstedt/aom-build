{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "iv.aom/routing-decision/v1",
  "title": "AOM Routing Decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "decision_id", "task_ref", "policy", "inputs", "strategy", "decided_at", "producer"],
  "properties": {
    "schema": {"const": "iv.aom/routing-decision/v1"},
    "decision_id": {"type": "string", "minLength": 1},
    "task_ref": {"$ref": "#/$defs/ref"},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": {"type": "string"},
        "version": {"type": "integer", "minimum": 1},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_type", "assurance", "classification", "locality", "ambiguity", "parallelizable", "budget_class"],
      "properties": {
        "task_type": {"type": "string"},
        "assurance": {"enum": ["standard", "high", "publication_critical"]},
        "classification": {"enum": ["internal", "confidential", "personal", "published"]},
        "locality": {"enum": ["hosted_allowed", "vm_only", "named_endpoint_only"]},
        "ambiguity": {"enum": ["low", "medium", "high"]},
        "parallelizable": {"type": "boolean"},
        "budget_class": {"enum": ["low", "standard", "high"]}
      }
    },
    "strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy_id", "stages"],
      "properties": {
        "strategy_id": {"type": "string", "minLength": 1},
        "stages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "role", "required_capabilities", "candidate_workers"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "role": {"type": "string", "minLength": 1},
              "required_capabilities": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "candidate_workers": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "independent_of": {"type": "array", "items": {"type": "string"}},
              "parallel_group": {"type": "string"},
              "constraints": {"type": "object"}
            }
          }
        },
        "fallbacks": {"type": "array", "items": {"type": "object"}}
      }
    },
    "decided_at": {"type": "string", "format": "date-time"},
    "producer": {"$ref": "#/$defs/producer"}
  },
  "$defs": {
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "id"],
      "properties": {
        "domain": {"enum": ["product", "work", "routing", "worker", "memory", "evidence", "audit", "publication"]},
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string"},
        "revision": {"type": ["string", "integer"]},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "uri": {"type": "string"}
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {"id": {"type": "string"}, "version": {"type": "string"}}
    }
  }
}
