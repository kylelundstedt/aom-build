{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "iv.aom/memory-record/v1",
  "title": "AOM Semantic Memory Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "memory_id", "scope", "type", "statement", "authority", "confidence", "derived_from", "validity", "status", "sensitivity", "created_at", "producer"],
  "properties": {
    "schema": {"const": "iv.aom/memory-record/v1"},
    "memory_id": {"type": "string", "minLength": 1},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trust_zone", "agent_id"],
      "properties": {
        "trust_zone": {"enum": ["personal", "internal_product"]},
        "agent_id": {"type": "string"},
        "product_id": {"type": "string"},
        "project_id": {"type": "string"}
      }
    },
    "type": {"enum": ["observation", "hypothesis", "rationale", "procedure", "preference"]},
    "statement": {"type": "string", "minLength": 1},
    "authority": {"const": "non_canonical"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "derived_from": {"type": "array", "items": {"$ref": "#/$defs/ref"}},
    "validity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed_at", "staleness"],
      "properties": {
        "observed_at": {"type": "string", "format": "date-time"},
        "review_after": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "staleness": {"enum": ["fresh", "unknown", "stale"]}
      }
    },
    "status": {"enum": ["active", "superseded", "retracted"]},
    "sensitivity": {"enum": ["internal", "confidential", "personal"]},
    "created_at": {"type": "string", "format": "date-time"},
    "producer": {"$ref": "#/$defs/producer"}
  },
  "$defs": {
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "id"],
      "properties": {
        "domain": {"enum": ["product", "work", "routing", "worker", "memory", "evidence", "audit", "publication"]},
        "id": {"type": "string"},
        "version": {"type": "string"},
        "revision": {"type": ["string", "integer"]},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "uri": {"type": "string"}
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {"id": {"type": "string"}, "version": {"type": "string"}}
    }
  }
}
